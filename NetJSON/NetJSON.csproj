<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net40</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="AutomaticTypeConverter.cs" />
    <Compile Include="IntUtility.cs" />
    <Compile Include="Models.cs" />
    <Compile Include="NetJSON.cs" />
    <Compile Include="NetJSON.Internals.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="NetJSON.nuspec" />
  </ItemGroup>

  <Target Name="CopyOutputToLib" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).xml;$(TargetDir)$(TargetName).pdb" DestinationFolder="$(SolutionDir)NetJSON\lib\net40\" SkipUnchangedFiles="true" />
  </Target>
</Project>
