<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DefineConstants>TRACE;NET_35</DefineConstants>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>NetJSON</AssemblyName>
    <RootNamespace>NetJSON</RootNamespace>
    <PackageId>NetJSON</PackageId>
    <Version>1.4.7</Version>
    <Authors>NetJSON</Authors>
    <Company>NetJSON</Company>
    <Product>NetJSON</Product>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>TRACE;DEBUG;NET_35</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\NetJSON\Models.cs" Link="Models.cs" />
    <Compile Include="..\NetJSON\NetJSON.Internals.cs" Link="NetJSON.Internals.cs" />
    <Compile Include="..\NetJSON\Properties\AssemblyInfo.cs" Link="Properties\AssemblyInfo.cs" />
    <Compile Include="..\NetJSON\AutomaticTypeConverter.cs" Link="AutomaticTypeConverter.cs" />
    <Compile Include="..\NetJSON\IntUtility.cs" Link="IntUtility.cs" />
    <Compile Include="..\NetJSON\NetJSON.cs" Link="NetJSON.cs" />
    <Compile Include="Net35AndPCLExtensions.cs" />
    <Compile Include="Net35Extensions.cs" />
  </ItemGroup>

  <Target Name="CopyOutputToLib" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).xml;$(TargetDir)$(TargetName).pdb" DestinationFolder="$(SolutionDir)NetJSON\lib\net35\" SkipUnchangedFiles="true" />
  </Target>
</Project>
